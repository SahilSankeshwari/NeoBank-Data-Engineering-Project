# ---- Secrets & credentials (NEVER commit) ----
.env
.env.*
*.env
**/credentials*
**/*.pem
**/*.key
secrets.json

# ---- Data files (schema/DDL is committed; full data stays in the workspace/volumes) ----
*.csv
*.csv.*
data/
**/source_files/

# ---- Python ----
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.venv/

# ---- Databricks ----
.databricks/
*.log
.dbx/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- Local environment configuration ----
# Real connection details stay on your machine; commit only config/config.example.json
config/dev.json
config/prod.json